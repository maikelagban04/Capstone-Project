# ============================================================================
#  KyronTech – Client environment variables (Vite)
#  Copia questo file in `.env` (o `.env.local`) e compila i valori.
#  Tutte le variabili devono iniziare con VITE_ per essere esposte al bundle.
# ============================================================================

# Backend API base URL
# Sviluppo locale:
VITE_API_URL=http://localhost:5000/api
# Produzione (esempio Render/Railway):
# VITE_API_URL=https://kyrontech.onrender.com/api

# Email del super admin (deve combaciare con quella del server).
# Usata SOLO per nascondere/mostrare il link "Inventario" nell'header;
# la sicurezza vera è server-side.
VITE_SUPER_ADMIN_EMAIL=maikelagban04@gmail.com
