# ============================================================================
#  KyronTech – Server environment variables
#  Copia questo file in `.env` e compila i valori reali.
# ============================================================================

# ---- Core (OBBLIGATORI) -----------------------------------------------------
# Connessione MongoDB (locale o Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/kyrontech

# Stringa segreta per firmare i JWT. Genera con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=metti_qui_una_stringa_lunga_e_casuale

# Durata token (default 7d se omesso). Es: 1h, 12h, 7d, 30d
JWT_EXPIRES_IN=7d

# Porta del server Express
PORT=5000

# Ambiente
NODE_ENV=development

# ---- CORS / Frontend --------------------------------------------------------
# URL del frontend (CORS + redirect post-OAuth). Multipli separati da virgola.
CLIENT_URL=http://localhost:5173

# Permetti tutti i sottodomini *.vercel.app (utile in deploy preview). true/false.
CORS_ALLOW_VERCEL_APP=false

# ---- Super admin ------------------------------------------------------------
# Email del super admin che può accedere a /admin/inventory.
# Riservata: nessuno può registrarla via /auth/register (guard server-side).
SUPER_ADMIN_EMAIL=maikelagban04@gmail.com
SUPER_ADMIN_NAME=Maikel Agban

# Password del super admin. Viene hashata e salvata nel DB dal seed
# (npm run seed:super-admin). Min 6 caratteri, usa qualcosa di robusto.
SUPER_ADMIN_PASSWORD=cambia_questa_password_subito

# ---- Google OAuth (OPZIONALE: serve solo per il bottone "Continua con Google")
# Se non configurato, il bottone Google su /login risulterà non funzionante,
# ma il login email/password (incluso quello del super admin) funziona comunque.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ---- Cloudinary (OPZIONALE: upload immagini prodotti dall'admin) ------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Email transazionali (OPZIONALE) ----------------------------------------
# Se non configurate, le email di benvenuto / conferma ordine vengono saltate
# (l'app continua a funzionare normalmente).

# Opzione A: SMTP classico (Gmail, Mailtrap, ecc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="KyronTech <noreply@kyrontech.com>"
SMTP_DEBUG=false

# Opzione B: SendGrid (alternativa a SMTP)
SENDGRID_API_KEY=
SENDGRID_FROM="KyronTech <noreply@kyrontech.com>"
